# Lakuloka Web Environment Variables
# Copy this file to .env.local and fill in the values.
# One env serves ALL modules (resto, tracking, kitchen, queue) — single deploy.

# Root secret shared between this Next.js app and lakuloka-be. This app derives
# one daily X-Menu-Key from it; the raw secret is never sent over the wire.
# Must match lakuloka-be's MENU_API_SECRET. Server-side only.
MENU_API_SECRET=change-me-in-production-use-a-long-random-string

# Base URL of lakuloka-be (no trailing slash)
LAKULOKA_API_URL=https://mw.lakuloka.id/api/v1

# Local-dev hosts (add to /etc/hosts, all pointing to 127.0.0.1):
# resto.test track.test kitchen.test queue.test
# Dev server runs on :3001 (npm run dev). No per-module env needed.
