# Lakuloka Web Environment Variables
# Copy this file to .env.local and fill in the values.
# One env serves ALL modules (resto, tracking, kitchen, queue) — single deploy.

# API secret shared between this Next.js app and Lakuloka API.
# Must match 'menuApiSecret' in Lakuloka API config.
# NEVER expose this to the browser — it is server-side only.
MENU_API_SECRET=change-me-in-production-use-a-long-random-string

# Base URL of Lakuloka API (no trailing slash)
LAKULOKA_API_URL=https://api.lakuloka.id/v1

# Local-dev hosts (add to /etc/hosts, all pointing to 127.0.0.1):
# resto.test tracking.test kitchen.test queue.test
# Dev server runs on :3001 (npm run dev). No per-module env needed.
